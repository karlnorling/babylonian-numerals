{
  "name": "@babylonian/core",
  "version": "0.0.0",
  "description": "Render any number as Babylonian cuneiform numerals in SVG, with zero dependencies",
  "keywords": [
    "babylonian",
    "babylonian-numerals",
    "base-60",
    "cuneiform",
    "mesopotamia",
    "number",
    "numerals",
    "sexagesimal",
    "svg"
  ],
  "homepage": "https://karlnorling.github.io/babylonian-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/babylonian-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/babylonian-numerals.git",
    "directory": "packages/@babylonian/core"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
