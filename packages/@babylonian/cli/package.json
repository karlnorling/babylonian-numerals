{
  "name": "@babylonian/cli",
  "version": "0.1.0",
  "description": "Draw Babylonian cuneiform numerals from the command line: SVG, PNG, JPEG or WebP",
  "keywords": [
    "babylonian",
    "babylonian-numerals",
    "base-60",
    "cli",
    "cuneiform",
    "mesopotamia",
    "number",
    "numerals",
    "png",
    "sexagesimal",
    "svg"
  ],
  "homepage": "https://karlnorling.github.io/babylonian-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/babylonian-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/babylonian-numerals.git",
    "directory": "packages/@babylonian/cli"
  },
  "bin": {
    "babylonian": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@babylonian/core": "workspace:^",
    "@babylonian/raster": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
